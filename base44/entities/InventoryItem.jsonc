{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "minimum_stock": {
      "type": "number",
      "default": 0
    },
    "cost_per_unit": {
      "type": "number",
      "default": 0
    },
    "supplier": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock"
      ],
      "default": "in_stock"
    }
  },
  "required": [
    "name",
    "unit"
  ]
}